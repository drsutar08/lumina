# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Unity LevelPlay Mediation App Key & Ad Unit IDs (configure via AI Studio Secrets panel)
LEVELPLAY_APP_KEY=MY_LEVELPLAY_APP_KEY
LEVELPLAY_BANNER_AD_UNIT_ID=MY_LEVELPLAY_BANNER_AD_UNIT_ID
LEVELPLAY_NATIVE_PLACEMENT_NAME=MY_LEVELPLAY_NATIVE_PLACEMENT_NAME
LEVELPLAY_REWARDED_AD_UNIT_ID=MY_LEVELPLAY_REWARDED_AD_UNIT_ID
LEVELPLAY_INTERSTITIAL_AD_UNIT_ID=MY_LEVELPLAY_INTERSTITIAL_AD_UNIT_ID
